{
  "name": "standard-notes-aic-editor",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "AIC Markdown editor component for Standard Notes",
  "homepage": "https://ldzyha.github.io/standard-notes-aic/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldzyha/standard-notes-aic.git"
  },
  "bugs": {
    "url": "https://github.com/ldzyha/standard-notes-aic/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sn": {
    "name": "AIC",
    "content_type": "SN|Component",
    "main": "dist/index.html",
    "area": "editor-editor",
    "spellcheckControl": true,
    "interchangeable": true,
    "note_type": "markdown",
    "file_type": "md",
    "showInGallery": false
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sass": "6.0.2",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@lezer/markdown": "1.6.4",
    "mermaid": "11.16.1",
    "sn-extension-api": "0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
